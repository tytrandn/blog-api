                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create a new post",
                "description": "Create a new post with required fields",
                "operationId": "0af3f7c4a45bc3e5338dd36d8ee24395",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "title",
                                    "content",
                                    "author_id"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string"
                                    },
                                    "content": {
                                        "type": "string"
                                    },
                                    "author_id": {
                                        "type": "integer"
                                    }
